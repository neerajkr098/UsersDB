<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Edit User | UserDB</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
  <style>
    :root {
      --bg:#030712; --surface:rgba(255,255,255,0.035); --border:rgba(255,255,255,0.07);
      --violet:#7c3aed; --violet2:#a78bfa; --cyan:#06b6d4;
      --rose:#f43f5e; --emerald:#10b981; --text:#f1f5f9; --muted:rgba(255,255,255,0.38);
      --sidebar-w:240px;
    }
    *,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
    body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;display:flex;overflow-x:hidden;}
    body::before{content:'';position:fixed;inset:0;background:radial-gradient(ellipse 55% 55% at 20% 20%, rgba(124,58,237,.14), transparent), radial-gradient(ellipse 50% 50% at 85% 75%, rgba(167,139,250,.1), transparent);pointer-events:none;z-index:0;}

    /* SIDEBAR */
    .sidebar{position:fixed;top:0;left:0;bottom:0;width:var(--sidebar-w);background:rgba(3,7,18,0.88);backdrop-filter:blur(20px);border-right:1px solid var(--border);display:flex;flex-direction:column;z-index:50;padding:0 0 24px;}
    .sidebar-logo{padding:28px 24px 24px;border-bottom:1px solid var(--border);margin-bottom:8px;}
    .logo-mark{display:inline-flex;align-items:center;gap:10px;text-decoration:none;}
    .logo-icon{width:36px;height:36px;background:linear-gradient(135deg,var(--violet),var(--cyan));border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1rem;box-shadow:0 0 20px rgba(124,58,237,.4);}
    .logo-text{font-size:1.15rem;font-weight:700;color:#fff;} .logo-text span{color:var(--violet2);}
    .nav-section{padding:8px 12px;flex:1;}
    .nav-label{font-size:.68rem;font-weight:600;text-transform:uppercase;letter-spacing:1px;color:var(--muted);padding:8px 12px 6px;}
    .nav-item{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;color:var(--muted);text-decoration:none;font-size:.88rem;font-weight:500;transition:all .2s;margin-bottom:2px;position:relative;}
    .nav-item:hover{background:rgba(255,255,255,.05);color:#fff;}
    .nav-item.edit-active{background:rgba(124,58,237,.18);color:var(--violet2);border:1px solid rgba(124,58,237,.25);}
    .nav-icon{font-size:1rem;width:20px;text-align:center;}
    .sidebar-footer{padding:16px 24px 0;border-top:1px solid var(--border);}
    .status-dot{display:flex;align-items:center;gap:8px;font-size:.78rem;color:var(--muted);}
    .dot{width:7px;height:7px;border-radius:50%;background:var(--emerald);box-shadow:0 0 8px var(--emerald);animation:pulse 2s infinite;}
    @keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}

    /* MAIN */
    .main{margin-left:var(--sidebar-w);flex:1;min-height:100vh;position:relative;z-index:1;display:flex;align-items:center;justify-content:center;padding:40px;}

    /* CARD */
    .form-card{
      background:rgba(255,255,255,.04);
      border:1px solid rgba(124,58,237,.2);
      border-radius:24px;
      padding:48px 44px;
      width:100%;max-width:500px;
      backdrop-filter:blur(20px);
      box-shadow:0 32px 80px rgba(0,0,0,.45);
      animation:fadeUp .5s cubic-bezier(.22,1,.36,1);
    }
    @keyframes fadeUp{from{opacity:0;transform:translateY(28px)}to{opacity:1;transform:translateY(0)}}

    /* User chip */
    .user-chip{
      display:flex;align-items:center;gap:14px;
      background:rgba(124,58,237,.1);
      border:1px solid rgba(124,58,237,.2);
      border-radius:16px;padding:14px 18px;
      margin-bottom:28px;
    }
    .avatar{
      width:44px;height:44px;border-radius:50%;
      background:linear-gradient(135deg,var(--violet),var(--violet2));
      display:flex;align-items:center;justify-content:center;
      font-size:1.1rem;font-weight:700;color:#fff;flex-shrink:0;
      box-shadow:0 4px 16px rgba(124,58,237,.35);
    }
    .user-meta{}
    .meta-label{font-size:.7rem;font-weight:600;text-transform:uppercase;letter-spacing:.7px;color:var(--muted);margin-bottom:3px;}
    .meta-email{font-size:.9rem;color:var(--violet2);font-weight:500;}

    h1{font-size:1.7rem;font-weight:800;color:#fff;margin-bottom:6px;}
    .subtitle{font-size:.87rem;color:var(--muted);margin-bottom:28px;line-height:1.5;}

    /* Info */
    .info-note{background:rgba(124,58,237,.08);border:1px solid rgba(124,58,237,.18);border-radius:11px;padding:11px 15px;font-size:.82rem;color:rgba(255,255,255,.4);margin-bottom:26px;display:flex;align-items:flex-start;gap:8px;line-height:1.5;}

    /* Fields */
    .form-group{margin-bottom:22px;}
    label.field-label{display:block;font-size:.78rem;font-weight:600;color:var(--muted);margin-bottom:8px;text-transform:uppercase;letter-spacing:.8px;}
    .input-wrap{position:relative;}
    .input-prefix{position:absolute;left:14px;top:50%;transform:translateY(-50%);font-size:.95rem;opacity:.4;pointer-events:none;}
    .ta-prefix{top:16px;transform:none;}

    textarea, input[type="password"]{
      width:100%;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.09);
      border-radius:13px;padding:14px 16px 14px 42px;
      color:#fff;font-size:.93rem;font-family:'Inter',sans-serif;outline:none;transition:all .22s;
    }
    textarea{min-height:76px;resize:none;line-height:1.5;}
    textarea::placeholder, input::placeholder{color:rgba(255,255,255,.22);}
    textarea:focus, input[type="password"]:focus{
      border-color:var(--violet2);
      background:rgba(124,58,237,.08);
      box-shadow:0 0 0 3px rgba(124,58,237,.18);
    }
    .char-count{text-align:right;font-size:.73rem;color:var(--muted);margin-top:5px;transition:color .2s;}
    .char-count.warn{color:#fb923c;}

    /* Divider */
    .divider{height:1px;background:var(--border);margin:22px 0;}

    /* Buttons */
    .btn-row{display:flex;gap:12px;margin-top:4px;}
    .btn-cancel{
      flex:1;padding:14px;background:rgba(255,255,255,.05);
      border:1px solid rgba(255,255,255,.1);border-radius:13px;
      color:var(--muted);font-size:.93rem;font-weight:600;
      font-family:'Inter',sans-serif;cursor:pointer;
      text-decoration:none;display:flex;align-items:center;justify-content:center;gap:6px;
      transition:all .22s;
    }
    .btn-cancel:hover{background:rgba(255,255,255,.09);color:#fff;transform:translateY(-1px);}
    .btn-save{
      flex:2;padding:14px;
      background:linear-gradient(135deg,var(--violet),#5b21b6);
      border:none;border-radius:13px;color:#fff;
      font-size:.93rem;font-weight:700;
      font-family:'Inter',sans-serif;cursor:pointer;
      display:flex;align-items:center;justify-content:center;gap:8px;
      transition:all .25s;letter-spacing:.3px;
      box-shadow:0 6px 20px rgba(124,58,237,.3);
    }
    .btn-save:hover{transform:translateY(-2px);box-shadow:0 14px 36px rgba(124,58,237,.5);}
    .btn-save:active{transform:translateY(0);}
  </style>
</head>
<body>

  <aside class="sidebar">
    <div class="sidebar-logo">
      <a href="/" class="logo-mark">
        <div class="logo-icon">🗄️</div>
        <span class="logo-text">User<span>DB</span></span>
      </a>
    </div>
    <nav class="nav-section">
      <div class="nav-label">Navigation</div>
      <a href="/"     class="nav-item"><span class="nav-icon">⚡</span> Dashboard</a>
      <a href="/user" class="nav-item"><span class="nav-icon">👥</span> All Users</a>
      <div class="nav-label" style="margin-top:12px">Actions</div>
      <a href="/user/new"    class="nav-item"><span class="nav-icon">➕</span> Add User</a>
      <a href="/user/delete" class="nav-item"><span class="nav-icon">🗑️</span> Delete User</a>
      <a href="#" class="nav-item edit-active" style="margin-top:2px"><span class="nav-icon">✏️</span> Edit User</a>
    </nav>
    <div class="sidebar-footer">
      <div class="status-dot"><div class="dot"></div>MySQL · Connected</div>
    </div>
  </aside>

  <main class="main">
    <div class="form-card">

      <!-- Who's being edited -->
      <div class="user-chip">
        <div class="avatar"><%= user.username ? user.username[0].toUpperCase() : '?' %></div>
        <div class="user-meta">
          <div class="meta-label">Editing account</div>
          <div class="meta-email"><%= user.email %></div>
        </div>
      </div>

      <h1>✏️ Edit Username</h1>
      <p class="subtitle">Update the username for this account. Confirm with the current password.</p>

      <div class="info-note">
        ℹ️ Only the <strong style="color:rgba(255,255,255,.65)">username</strong> field can be modified here.
      </div>

      <form method="POST" action="/user/<%= user.id %>?_method=PATCH" id="editForm">

        <div class="form-group">
          <label class="field-label" for="username">New Username</label>
          <div class="input-wrap">
            <span class="input-prefix ta-prefix">👤</span>
            <textarea
              id="username" name="username"
              maxlength="50"
              required
              oninput="updateCount(this)"
              style="padding-left:42px;"
            ><%= user.username %></textarea>
          </div>
          <div class="char-count" id="cc"><%= user.username ? user.username.length : 0 %> / 50</div>
        </div>

        <div class="divider"></div>

        <div class="form-group">
          <label class="field-label" for="password">Confirm with Password</label>
          <div class="input-wrap">
            <span class="input-prefix">🔒</span>
            <input type="password" id="password" name="password" placeholder="Enter your current password" required/>
          </div>
        </div>

        <div class="btn-row">
          <a href="/user" class="btn-cancel">✕ Cancel</a>
          <button type="submit" class="btn-save">💾 Save Changes</button>
        </div>
      </form>
    </div>
  </main>

  <script>
    function updateCount(el) {
      const cc = document.getElementById('cc');
      cc.textContent = el.value.length + ' / 50';
      cc.classList.toggle('warn', el.value.length > 40);
    }
  </script>
</body>
</html>
