<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Delete User | UserDB</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
  <style>
    :root {
      --bg:#030712; --surface:rgba(255,255,255,0.035); --border:rgba(255,255,255,0.07);
      --violet:#7c3aed; --violet2:#a78bfa; --cyan:#06b6d4;
      --rose:#f43f5e; --emerald:#10b981; --text:#f1f5f9; --muted:rgba(255,255,255,0.38);
      --sidebar-w:240px;
    }
    *,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
    body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;display:flex;overflow-x:hidden;}
    body::before{content:'';position:fixed;inset:0;background:radial-gradient(ellipse 60% 50% at 80% 15%, rgba(244,63,94,.15), transparent), radial-gradient(ellipse 50% 60% at 15% 85%, rgba(251,146,60,.08), transparent);pointer-events:none;z-index:0;}

    /* SIDEBAR */
    .sidebar{position:fixed;top:0;left:0;bottom:0;width:var(--sidebar-w);background:rgba(3,7,18,0.88);backdrop-filter:blur(20px);border-right:1px solid var(--border);display:flex;flex-direction:column;z-index:50;padding:0 0 24px;}
    .sidebar-logo{padding:28px 24px 24px;border-bottom:1px solid var(--border);margin-bottom:8px;}
    .logo-mark{display:inline-flex;align-items:center;gap:10px;text-decoration:none;}
    .logo-icon{width:36px;height:36px;background:linear-gradient(135deg,var(--violet),var(--cyan));border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1rem;box-shadow:0 0 20px rgba(124,58,237,.4);}
    .logo-text{font-size:1.15rem;font-weight:700;color:#fff;} .logo-text span{color:var(--violet2);}
    .nav-section{padding:8px 12px;flex:1;}
    .nav-label{font-size:.68rem;font-weight:600;text-transform:uppercase;letter-spacing:1px;color:var(--muted);padding:8px 12px 6px;}
    .nav-item{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;color:var(--muted);text-decoration:none;font-size:.88rem;font-weight:500;transition:all .2s;margin-bottom:2px;position:relative;}
    .nav-item:hover{background:rgba(255,255,255,.05);color:#fff;}
    .nav-item.active{background:rgba(244,63,94,.12);color:#fb7185;border:1px solid rgba(244,63,94,.22);}
    .nav-item.active::before{content:'';position:absolute;left:-12px;top:50%;transform:translateY(-50%);width:3px;height:60%;background:var(--rose);border-radius:0 3px 3px 0;}
    .nav-icon{font-size:1rem;width:20px;text-align:center;}
    .sidebar-footer{padding:16px 24px 0;border-top:1px solid var(--border);}
    .status-dot{display:flex;align-items:center;gap:8px;font-size:.78rem;color:var(--muted);}
    .dot{width:7px;height:7px;border-radius:50%;background:var(--emerald);box-shadow:0 0 8px var(--emerald);animation:pulse 2s infinite;}
    @keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}

    /* MAIN */
    .main{margin-left:var(--sidebar-w);flex:1;min-height:100vh;position:relative;z-index:1;display:flex;align-items:center;justify-content:center;padding:40px;}

    /* FORM CARD */
    .form-card{
      background:rgba(255,255,255,.03);
      border:1px solid rgba(244,63,94,.18);
      border-radius:24px;
      padding:48px 44px;
      width:100%;max-width:480px;
      backdrop-filter:blur(20px);
      box-shadow:0 32px 80px rgba(0,0,0,.45);
      animation:fadeUp .5s cubic-bezier(.22,1,.36,1);
    }
    @keyframes fadeUp{from{opacity:0;transform:translateY(28px)}to{opacity:1;transform:translateY(0)}}

    .card-badge{display:inline-flex;align-items:center;gap:6px;background:rgba(244,63,94,.1);border:1px solid rgba(244,63,94,.25);border-radius:999px;padding:5px 14px;font-size:.75rem;font-weight:600;color:#fb7185;margin-bottom:20px;}
    h1{font-size:1.75rem;font-weight:800;color:#fff;margin-bottom:6px;}
    .subtitle{font-size:.88rem;color:var(--muted);margin-bottom:28px;line-height:1.5;}

    /* Warning */
    .warning-box{
      background:rgba(251,146,60,.08); border:1px solid rgba(251,146,60,.2);
      border-radius:12px; padding:13px 16px;
      color:#fdba74; font-size:.83rem;
      margin-bottom:24px;
      display:flex; align-items:flex-start; gap:10px; line-height:1.5;
    }

    /* Error */
    .error-box{
      background:rgba(244,63,94,.12);border:1px solid rgba(244,63,94,.3);
      border-radius:12px;padding:12px 16px;color:#fb7185;font-size:.85rem;
      margin-bottom:24px;display:flex;align-items:center;gap:8px;
      animation:shake .4s ease;
    }
    @keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}

    /* Fields */
    .form-group{margin-bottom:22px;}
    label{display:block;font-size:.78rem;font-weight:600;color:var(--muted);margin-bottom:8px;text-transform:uppercase;letter-spacing:.8px;}
    .input-wrap{position:relative;}
    .input-prefix{position:absolute;left:14px;top:50%;transform:translateY(-50%);font-size:.95rem;opacity:.4;pointer-events:none;}
    input[type="email"]{
      width:100%;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.09);
      border-radius:13px;padding:14px 16px 14px 42px;color:#fff;
      font-size:.93rem;font-family:'Inter',sans-serif;outline:none;transition:all .22s;
    }
    input[type="email"]::placeholder{color:rgba(255,255,255,.22);}
    input[type="email"]:focus{border-color:var(--rose);background:rgba(244,63,94,.07);box-shadow:0 0 0 3px rgba(244,63,94,.15);}

    /* Confirm */
    .confirm-row{
      display:flex;align-items:center;gap:11px;
      padding:14px 16px;
      background:rgba(244,63,94,.06);
      border:1px solid rgba(244,63,94,.15);
      border-radius:12px;
      cursor:pointer;
      margin-bottom:22px;
      transition:background .2s;
    }
    .confirm-row:hover{background:rgba(244,63,94,.1);}
    .confirm-row input[type="checkbox"]{
      width:17px;height:17px;border-radius:4px;
      accent-color:var(--rose);cursor:pointer;
      flex-shrink:0;
    }
    .confirm-row span{font-size:.84rem;color:rgba(255,255,255,.5);line-height:1.4;}

    /* Delete btn */
    .btn-delete{
      width:100%;padding:15px;
      background:linear-gradient(135deg,#f43f5e,#be123c);
      border:none;border-radius:13px;color:#fff;
      font-size:.97rem;font-weight:700;
      font-family:'Inter',sans-serif;cursor:pointer;
      transition:all .25s;letter-spacing:.3px;
      box-shadow:0 6px 24px rgba(244,63,94,.3);
    }
    .btn-delete:hover{transform:translateY(-2px);box-shadow:0 14px 36px rgba(244,63,94,.5);}
    .btn-delete:active{transform:translateY(0);}
    .btn-delete:disabled{opacity:.35;cursor:not-allowed;transform:none;box-shadow:none;}

    .back-link{display:block;text-align:center;margin-top:18px;font-size:.85rem;color:var(--muted);text-decoration:none;transition:color .2s;}
    .back-link:hover{color:#fff;}
  </style>
</head>
<body>

  <aside class="sidebar">
    <div class="sidebar-logo">
      <a href="/" class="logo-mark">
        <div class="logo-icon">🗄️</div>
        <span class="logo-text">User<span>DB</span></span>
      </a>
    </div>
    <nav class="nav-section">
      <div class="nav-label">Navigation</div>
      <a href="/"     class="nav-item"><span class="nav-icon">⚡</span> Dashboard</a>
      <a href="/user" class="nav-item"><span class="nav-icon">👥</span> All Users</a>
      <div class="nav-label" style="margin-top:12px">Actions</div>
      <a href="/user/new"    class="nav-item"><span class="nav-icon">➕</span> Add User</a>
      <a href="/user/delete" class="nav-item active"><span class="nav-icon">🗑️</span> Delete User</a>
    </nav>
    <div class="sidebar-footer">
      <div class="status-dot"><div class="dot"></div>MySQL · Connected</div>
    </div>
  </aside>

  <main class="main">
    <div class="form-card">
      <div class="card-badge">⚠️ Danger Zone</div>
      <h1>Delete Account</h1>
      <p class="subtitle">Permanently remove a user from the database. This <strong style="color:#fb7185">cannot be undone</strong>.</p>

      <div class="warning-box">
        ⚠️ Enter the exact registered email address. The account will be deleted immediately.
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="error-box">❌ <%= error %></div>
      <% } %>

      <form method="POST" action="/user/delete?_method=DELETE" id="deleteForm">
        <div class="form-group">
          <label for="email">Registered Email</label>
          <div class="input-wrap">
            <span class="input-prefix">✉️</span>
            <input type="email" id="email" name="email" placeholder="e.g. john@example.com" required autocomplete="off"/>
          </div>
        </div>

        <label class="confirm-row" for="confirmCheck">
          <input type="checkbox" id="confirmCheck" onchange="toggleBtn(this)"/>
          <span>I understand this will <strong style="color:#fb7185">permanently delete</strong> the account and all associated data.</span>
        </label>

        <button type="submit" class="btn-delete" id="deleteBtn" disabled>
          🗑️ Delete Account Permanently
        </button>
      </form>

      <a href="/user" class="back-link">← Back to All Users</a>
    </div>
  </main>

  <script>
    function toggleBtn(cb) {
      document.getElementById('deleteBtn').disabled = !cb.checked;
    }
  </script>
</body>
</html>
