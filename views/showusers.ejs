<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>All Users | UserDB</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
  <style>
    :root {
      --bg:       #030712;
      --surface:  rgba(255,255,255,0.035);
      --border:   rgba(255,255,255,0.07);
      --violet:   #7c3aed;
      --violet2:  #a78bfa;
      --cyan:     #06b6d4;
      --rose:     #f43f5e;
      --emerald:  #10b981;
      --text:     #f1f5f9;
      --muted:    rgba(255,255,255,0.38);
      --sidebar-w: 240px;
    }
    *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      overflow-x: hidden;
    }
    body::before {
      content:'';
      position:fixed; inset:0;
      background:
        radial-gradient(ellipse 60% 50% at 10% 10%, rgba(124,58,237,.15), transparent),
        radial-gradient(ellipse 50% 60% at 90% 80%, rgba(6,182,212,.1), transparent);
      pointer-events:none; z-index:0;
    }

    /* SIDEBAR */
    .sidebar {
      position:fixed; top:0; left:0; bottom:0;
      width: var(--sidebar-w);
      background: rgba(3,7,18,0.88);
      backdrop-filter:blur(20px);
      border-right:1px solid var(--border);
      display:flex; flex-direction:column;
      z-index:50; padding:0 0 24px;
    }
    .sidebar-logo { padding:28px 24px 24px; border-bottom:1px solid var(--border); margin-bottom:8px; }
    .logo-mark { display:inline-flex; align-items:center; gap:10px; text-decoration:none; }
    .logo-icon { width:36px; height:36px; background:linear-gradient(135deg,var(--violet),var(--cyan)); border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:1rem; box-shadow:0 0 20px rgba(124,58,237,.4); }
    .logo-text { font-size:1.15rem; font-weight:700; color:#fff; }
    .logo-text span { color:var(--violet2); }
    .nav-section { padding:8px 12px; flex:1; }
    .nav-label { font-size:.68rem; font-weight:600; text-transform:uppercase; letter-spacing:1px; color:var(--muted); padding:8px 12px 6px; }
    .nav-item { display:flex; align-items:center; gap:10px; padding:10px 12px; border-radius:10px; color:var(--muted); text-decoration:none; font-size:.88rem; font-weight:500; transition:all .2s; margin-bottom:2px; position:relative; }
    .nav-item:hover { background:rgba(255,255,255,.05); color:#fff; }
    .nav-item.active { background:rgba(124,58,237,.2); color:var(--violet2); border:1px solid rgba(124,58,237,.25); }
    .nav-item.active::before { content:''; position:absolute; left:-12px; top:50%; transform:translateY(-50%); width:3px; height:60%; background:var(--violet); border-radius:0 3px 3px 0; }
    .nav-icon { font-size:1rem; width:20px; text-align:center; }
    .sidebar-footer { padding:16px 24px 0; border-top:1px solid var(--border); }
    .status-dot { display:flex; align-items:center; gap:8px; font-size:.78rem; color:var(--muted); }
    .dot { width:7px; height:7px; border-radius:50%; background:var(--emerald); box-shadow:0 0 8px var(--emerald); animation:pulse 2s infinite; }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.4} }

    /* MAIN */
    .main { margin-left:var(--sidebar-w); flex:1; min-height:100vh; position:relative; z-index:1; }
    .topbar { padding:28px 40px 0; display:flex; align-items:flex-start; justify-content:space-between; flex-wrap:wrap; gap:16px; }
    .page-eyebrow { font-size:.75rem; font-weight:600; text-transform:uppercase; letter-spacing:1px; color:var(--violet2); margin-bottom:6px; }
    .page-title { font-size:1.8rem; font-weight:800; color:#fff; }
    .page-sub { color:var(--muted); font-size:.88rem; margin-top:4px; }

    .btn-row { display:flex; gap:10px; align-self:flex-start; padding-top:4px; }
    .btn {
      display:inline-flex; align-items:center; gap:7px;
      padding:10px 20px; border-radius:10px;
      font-size:.85rem; font-weight:600; font-family:'Inter',sans-serif;
      text-decoration:none; border:none; cursor:pointer;
      transition:all .22s;
    }
    .btn-violet { background:linear-gradient(135deg,var(--violet),#5b21b6); color:#fff; box-shadow:0 4px 16px rgba(124,58,237,.3); }
    .btn-violet:hover { transform:translateY(-2px); box-shadow:0 10px 28px rgba(124,58,237,.45); }
    .btn-ghost { background:var(--surface); color:var(--muted); border:1px solid var(--border); }
    .btn-ghost:hover { background:rgba(255,255,255,.07); color:#fff; transform:translateY(-2px); }
    .btn-rose { background:rgba(244,63,94,.1); color:#fb7185; border:1px solid rgba(244,63,94,.2); }
    .btn-rose:hover { background:rgba(244,63,94,.2); transform:translateY(-2px); }

    .content { padding:28px 40px 60px; }

    /* TABLE CARD */
    .table-wrap {
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--border);
      border-radius: 20px;
      overflow: hidden;
      backdrop-filter: blur(16px);
      box-shadow: 0 24px 64px rgba(0,0,0,.4);
      animation: fadeUp .45s cubic-bezier(.22,1,.36,1);
    }
    @keyframes fadeUp { from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:translateY(0)} }

    /* table header bar */
    .table-header {
      padding: 18px 24px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .table-header-title { font-size:.9rem; font-weight:600; color:#fff; display:flex; align-items:center; gap:8px; }
    .count-pill {
      background:rgba(124,58,237,.2);
      border:1px solid rgba(124,58,237,.3);
      color:var(--violet2);
      border-radius:999px;
      padding:2px 10px;
      font-size:.75rem;
      font-weight:700;
    }

    table { width:100%; border-collapse:collapse; }
    thead tr { background:rgba(255,255,255,.02); }
    th {
      padding:13px 20px;
      text-align:left;
      font-size:.72rem;
      font-weight:600;
      text-transform:uppercase;
      letter-spacing:.9px;
      color:var(--muted);
    }
    td {
      padding:14px 20px;
      font-size:.88rem;
      color:rgba(255,255,255,.75);
      border-top:1px solid var(--border);
      vertical-align:middle;
    }
    tbody tr { transition:background .18s; }
    tbody tr:hover { background:rgba(124,58,237,.06); }

    /* Avatar */
    .user-cell { display:flex; align-items:center; gap:12px; }
    .avatar {
      width:36px; height:36px; border-radius:50%;
      display:flex; align-items:center; justify-content:center;
      font-size:.88rem; font-weight:700; color:#fff; flex-shrink:0;
      font-style:normal;
    }
    .av0 { background:linear-gradient(135deg,#7c3aed,#a78bfa); }
    .av1 { background:linear-gradient(135deg,#06b6d4,#0ea5e9); }
    .av2 { background:linear-gradient(135deg,#f43f5e,#fb923c); }
    .av3 { background:linear-gradient(135deg,#10b981,#34d399); }
    .av4 { background:linear-gradient(135deg,#f59e0b,#fbbf24); }

    .user-name { font-weight:600; color:#fff; font-size:.9rem; }

    /* Email chip */
    .email-chip { display:inline-flex; align-items:center; gap:6px; font-size:.85rem; color:var(--muted); }

    /* ID pill */
    .id-pill { font-family:monospace; font-size:.72rem; color:rgba(255,255,255,.25); background:rgba(255,255,255,.05); padding:3px 8px; border-radius:6px; display:inline-block; max-width:110px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }

    /* Password dots */
    .pwd { letter-spacing:4px; color:rgba(255,255,255,.2); font-size:.8rem; }

    /* Edit btn */
    .btn-edit {
      display:inline-flex; align-items:center; gap:5px;
      padding:6px 14px; border-radius:8px;
      background:rgba(124,58,237,.1); border:1px solid rgba(124,58,237,.22);
      color:var(--violet2); font-size:.8rem; font-weight:600;
      font-family:'Inter',sans-serif; text-decoration:none; cursor:pointer;
      transition:all .2s;
    }
    .btn-edit:hover { background:rgba(124,58,237,.25); transform:translateY(-1px); }

    /* Empty */
    .empty { text-align:center; padding:64px 24px; color:var(--muted); }
    .empty .e-icon { font-size:3rem; margin-bottom:16px; }
    .empty a { color:var(--violet2); }
  </style>
</head>
<body>

  <aside class="sidebar">
    <div class="sidebar-logo">
      <a href="/" class="logo-mark">
        <div class="logo-icon">🗄️</div>
        <span class="logo-text">User<span>DB</span></span>
      </a>
    </div>
    <nav class="nav-section">
      <div class="nav-label">Navigation</div>
      <a href="/" class="nav-item"><span class="nav-icon">⚡</span> Dashboard</a>
      <a href="/user" class="nav-item active"><span class="nav-icon">👥</span> All Users</a>
      <div class="nav-label" style="margin-top:12px">Actions</div>
      <a href="/user/new"    class="nav-item"><span class="nav-icon">➕</span> Add User</a>
      <a href="/user/delete" class="nav-item"><span class="nav-icon">🗑️</span> Delete User</a>
    </nav>
    <div class="sidebar-footer">
      <div class="status-dot"><div class="dot"></div>MySQL · Connected</div>
    </div>
  </aside>

  <main class="main">
    <div class="topbar">
      <div>
        <div class="page-eyebrow">Database</div>
        <h1 class="page-title">All Users</h1>
        <p class="page-sub"><%= users.length %> record<%= users.length !== 1 ? 's' : '' %> found</p>
      </div>
      <div class="btn-row">
        <a href="/user/new"    class="btn btn-violet">➕ Add User</a>
        <a href="/user/delete" class="btn btn-rose">🗑️ Delete</a>
      </div>
    </div>

    <div class="content">
      <div class="table-wrap">
        <div class="table-header">
          <div class="table-header-title">
            👥 Users
            <span class="count-pill"><%= users.length %></span>
          </div>
        </div>

        <% if (users.length === 0) { %>
          <div class="empty">
            <div class="e-icon">🫙</div>
            <p>No users yet. <a href="/user/new">Add the first one →</a></p>
          </div>
        <% } else { %>
          <table>
            <thead>
              <tr>
                <th>User</th>
                <th>Email</th>
                <th>ID</th>
                <th>Password</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach((user, i) => { %>
                <tr>
                  <td>
                    <div class="user-cell">
                      <div class="avatar av<%= i % 5 %>"><%= user.username ? user.username[0].toUpperCase() : '?' %></div>
                      <span class="user-name"><%= user.username %></span>
                    </div>
                  </td>
                  <td><span class="email-chip">✉️ <%= user.email %></span></td>
                  <td><span class="id-pill" title="<%= user.id %>"><%= user.id %></span></td>
                  <td><span class="pwd">••••••••</span></td>
                  <td>
                    <a href="/user/<%= user.id %>/edit" class="btn-edit">✏️ Edit</a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>
  </main>

</body>
</html>