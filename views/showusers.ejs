<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Users Database - All Users</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: Arial, sans-serif; background-color: #f8f9fa; color: #333; padding: 24px; line-height: 1.5; }
    .container { max-width: 1000px; margin: 0 auto; background: #ffffff; border: 1px solid #d1d5db; border-radius: 4px; padding: 24px; }
    .nav { margin-bottom: 20px; padding-bottom: 12px; border-bottom: 1px solid #e5e7eb; }
    .nav a { color: #0d6efd; text-decoration: none; margin-right: 15px; font-size: 14px; }
    .nav a:hover { text-decoration: underline; }
    .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
    h1 { font-size: 22px; color: #111; }
    .user-count { font-size: 14px; color: #666; }
    table { width: 100%; border-collapse: collapse; margin-top: 12px; font-size: 14px; }
    th, td { border: 1px solid #d1d5db; padding: 8px 12px; text-align: left; }
    th { background-color: #f3f4f6; color: #374151; font-weight: 600; }
    tr:nth-child(even) { background-color: #f9fafb; }
    tr:hover { background-color: #f1f5f9; }
    .id-col { font-family: monospace; font-size: 12px; color: #555; }
    .btn { display: inline-block; padding: 6px 12px; font-size: 13px; border-radius: 4px; text-decoration: none; border: 1px solid #ccc; cursor: pointer; }
    .btn-primary { background-color: #0d6efd; color: #fff; border-color: #0d6efd; }
    .btn-primary:hover { background-color: #0b5ed7; }
    .btn-sm { padding: 4px 8px; font-size: 12px; }
    .btn-edit { background-color: #e9ecef; color: #0d6efd; border-color: #ced4da; }
    .btn-edit:hover { background-color: #dde2e5; }
    .empty-state { padding: 24px; text-align: center; color: #666; border: 1px dashed #d1d5db; margin-top: 16px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="nav">
      <strong>UserDB (Backend)</strong> &nbsp;|&nbsp;
      <a href="/">Home</a>
      <a href="/user">All Users</a>
      <a href="/user/new">Add User</a>
      <a href="/user/delete">Delete User</a>
    </div>

    <div class="header">
      <div>
        <h1>All Registered Users</h1>
        <span class="user-count">Total: <%= users.length %> user(s) in MySQL database</span>
      </div>
      <div>
        <a href="/user/new" class="btn btn-primary">+ Add New User</a>
      </div>
    </div>

    <% if (users.length === 0) { %>
      <div class="empty-state">
        <p>No users found in database.</p>
        <p><a href="/user/new" style="color: #0d6efd;">Click here to add the first user</a></p>
      </div>
    <% } else { %>
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>ID</th>
            <th>Username</th>
            <th>Email</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach((user, index) => { %>
            <tr>
              <td><%= index + 1 %></td>
              <td class="id-col"><%= user.id %></td>
              <td><strong><%= user.username %></strong></td>
              <td><%= user.email %></td>
              <td>
                <a href="/user/<%= user.id %>/edit" class="btn btn-sm btn-edit">Edit</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</body>
</html>
